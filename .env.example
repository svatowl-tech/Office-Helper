# ==============================================================================
# АВТОНОМНЫЙ ОФИСНЫЙ ХАРНЕС (AIR-GAP EDITION) — КОНФИГУРАЦИЯ ОКРУЖЕНИЯ
# ==============================================================================

# Порт и интерфейс локального сервера (по умолчанию 0.0.0.0:3000)
PORT=3000
HOST=0.0.0.0

# Путь к локальной папке с моделями (без жестких платформенных слешей, резолвится через path.resolve)
LOCAL_MODELS_DIR=./models

# Путь к локальному исполняемому файлу движка инференса (llama-server / cosmocc / ONNX)
LOCAL_LLAMA_SERVER_URL=http://127.0.0.1:8080

# Название активной локальной модели по умолчанию
DEFAULT_MODEL_ID=sage-fredt5-distilled-95m-int8

# Путь к локальным словарям Tesseract OCR (rus.traineddata, eng.traineddata)
LOCAL_TESSDATA_DIR=./tessdata

# Стандартные параметры чанкинга длинных текстов для малых локальных CPU-моделей (SAGE 95M / Qwen2.5 1.5B)
HARNESS_CHUNK_MAX_CHARS=480
HARNESS_CHUNK_MAX_TOKENS=180

