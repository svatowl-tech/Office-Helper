{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server && npm run build:html",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/server.cjs --external:vite --external:mupdf --external:onnxruntime-web --external:tesseract.js",
    "build:html": "node scripts/build-standalone-html.mjs",
    "start": "tsx server.ts",
    "start:portable": "node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','dist-server','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@types/word-extractor": "^1.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "cfb": "^1.2.2",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jimp": "^1.6.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "mupdf": "^1.28.6",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
